<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_rounded_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCheckoutItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCheckoutItemSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warm_brown_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckoutItemMinus"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:backgroundTint="@color/cozy_surface"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="-"
        android:textColor="@color/burgundy"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:strokeColor="@color/burgundy"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvCheckoutItemQty"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckoutItemPlus"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:backgroundTint="@color/burgundy"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="16dp" />

    <ImageButton
        android:id="@+id/btnCheckoutItemDelete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clear_cart_short"
        android:src="@drawable/ic_delete"
        app:tint="@color/burgundy" />

</LinearLayout>
